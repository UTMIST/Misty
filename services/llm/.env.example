# Environment tier: local | staging | production
LLM_ENV=local

# Caller auth: env-bootstrap admin key (change outside local).
API_KEY=dev-api-key-change-me
# Per-consumer keys — a JSON array. Mint entries from the repo root with:
# uv --project services/llm run llm-keys --name <consumer> --scopes chat
# POST /chat requires the `chat` scope, so a key with "scopes":[] cannot call it.
# CONSUMER_KEYS=[{"name":"reviewer-summaries","prefix":"ab12cd34","key_hash":"$argon2id$...","scopes":["chat"]}]
CONSUMER_KEYS=

# Chat provider / model (defaults shown match src/config.py)
LLM_PROVIDER=bedrock-converse
LLM_MODEL=claude-sonnet-4-6

# OpenAI embeddings (billed through OpenAI, not AWS credits). No provider fallback.
# POST /embed requires the `embed` scope, so a key with only `chat` cannot call it.
# Models: openai-embed-3-small (default) or openai-embed-3-large; both use 1536 dims.
# Changing model requires re-embedding stored vectors even when widths match.
EMBED_MODEL=openai-embed-3-small
# Required outside local; locally, an absent key makes /embed return 503.
# OPENAI_API_KEY=sk-...
# Maximum total characters per /embed request; over it is 422 before an upstream call.
# Character limits are coarse input guards, not exact token or spending limits.
EMBED_MAX_REQUEST_CHARS=400000
# Provider SDK timeout setting, in seconds. For embeddings this configures timeout
# phases, not a whole-HTTP deadline; limiter waiting is excluded, retries disabled.
REQUEST_TIMEOUT_S=60
# Whether extended thinking is on when a /chat request omits `thinking`.
THINKING_DEFAULT=true

# Amazon Bedrock for chat (standard AWS credential chain also reads these).
# Chat bills as Amazon Bedrock (credits apply) — do NOT use Claude Platform on AWS.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
