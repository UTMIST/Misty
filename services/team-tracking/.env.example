DATABASE_URL=postgresql+psycopg://team_tracking:dev_password@localhost:5433/team_tracking
API_KEY=dev-api-key-change-me
# Environment tier: local | staging | production
# Default is `local`. Staging and production refuse to boot while API_KEY is
# the built-in dev default above — set a strong, unique API_KEY there.
# Only production refuses issuance and use of keys with literal dev:spoof scope.
TT_ENV=local
# Managed Google Groups (docs/DEPLOYMENT.md#managed-google-groups). Leave all
# five empty to run without Google; setting only some refuses to boot.
# OAuth grant needs cloud-identity.groups AND apps.groups.settings; see the runbook.
GOOGLE_GROUPS_CUSTOMER_ID=
GOOGLE_GROUPS_DOMAIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
