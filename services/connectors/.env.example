# Environment tier: local | staging | production
CONNECTORS_ENV=local

# Caller auth: env-bootstrap admin key (change outside local).
API_KEY=dev-api-key-change-me
# Per-consumer keys — a JSON array. Mint entries with `uv run connectors-keys --name <consumer> --scopes fetch`.
# CONSUMER_KEYS=[{"name":"documentation-system","prefix":"...","key_hash":"...","scopes":["fetch"]}]
CONSUMER_KEYS=
# base64 of the Google service-account JSON key file:
#   base64 -i service-account.json | tr -d '\n'
# Leave empty to run without Google access — /fetch then returns 503 for
# Google sources and the rest of the service works normally.
GOOGLE_CREDENTIALS_JSON=
# Optional GitHub token — a fine-grained, read-only PAT (Contents: read).
# Leave empty to fetch public repositories only; private ones then return 404.
GITHUB_TOKEN=
# Transport guard only (deliberately above documentation-system's own
# MAX_CONTENT_CHARS of 1,000,000, so that clamp stays the authoritative one):
MAX_CONTENT_CHARS=1200000
# Metadata precheck and streamed byte cap for uploaded PDF, DOCX, and text/*
# files, and for GitHub README/blob files. Missing/stale Drive size still has
# the streamed cap; oversized bodies are rejected before parsing.
# Native Google Docs/Sheets/Slides/Forms use their APIs instead.
MAX_FILE_BYTES=26214400
REQUEST_TIMEOUT_S=30

# Optional meeting writer: Workspace user OAuth, separate from read-only service account.
# Grant drive.file and create/select this root through the same OAuth app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_MEETING_ROOT_FOLDER_ID=
# JSON array: explicitly trusted infra user/group emails, including the owner
# and inherited Shared Drive administrators. Never allow an entire domain.
GOOGLE_MEETING_ADMIN_EMAILS=[]
