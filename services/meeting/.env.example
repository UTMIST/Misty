# Environment tier: local | staging | production
MEETING_ENV=local
# Startup and per-meeting summary logging; never log audio or transcript content.
LOG_LEVEL=INFO

# Caller auth: env-bootstrap admin key (change outside local).
API_KEY=dev-api-key-change-me
# Per-consumer keys — a JSON array. Mint entries with `uv run meeting-keys --name <consumer> --scopes meetings`.
# CONSUMER_KEYS=[{"name":"reviewer-summaries","prefix":"ab12cd34","key_hash":"$argon2id$...","scopes":["meetings"]}]
CONSUMER_KEYS=

# Per-request timeout to downstream services, in seconds.
REQUEST_TIMEOUT_S=60
# Safety backstop: a recording stops accepting audio past this many ms.
# The normal end is `/record stop` or auto-stop-on-empty; this only bounds a
# forgotten meeting. Defaults to 14400000 (4h), which is also AWS Transcribe's
# per-stream cap. See docs/MEETING-RECORDING.md.
MAX_MEETING_MS=14400000
# How long a session survives an abrupt WebSocket disconnect, in seconds.
# Call /stop promptly to attempt recovery. Starting stop does not cancel the
# grace timer; expiry can interrupt an unfinished transcript flush.
# Set to 0 to discard immediately. See docs/API.md#disconnect.
DISCONNECT_GRACE_S=60

# Amazon Transcribe (standard AWS credential chain also reads these).
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Shared LLM service (services/llm) used for minutes generation.
LLM_BASE_URL=http://localhost:8002
LLM_API_KEY=

# Durable transcript hand-off. The docs key requires meetings:write.
DOCS_BASE_URL=http://localhost:8001
DOCS_API_KEY=
RECORD_HANDOFF_HOLD_S=1800
