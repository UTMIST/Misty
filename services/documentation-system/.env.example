DATABASE_URL=postgresql+psycopg://docs:dev_password@localhost:5434/docs
API_KEY=dev-api-key-change-me
DIRECTORY_BASE_URL=http://localhost:8000
DIRECTORY_API_KEY=dev-api-key-change-me
CONNECTORS_BASE_URL=http://localhost:8005
CONNECTORS_API_KEY=dev-api-key-change-me
# Refresh Google ACLs daily; source-derived grants fail closed after 48 hours
# without a successful complete resync. MAX_AGE must exceed REFRESH_AFTER.
SOURCE_ACCESS_REFRESH_AFTER_HOURS=24
SOURCE_ACCESS_MAX_AGE_HOURS=48
# Environment tier: local | staging | production
# Default is `local`. Anything other than `local` (staging/production) makes the
# service refuse to boot while API_KEY or DIRECTORY_API_KEY is still the
# built-in dev default above — set strong, unique values there. CONNECTORS_API_KEY
# is a soft dependency: a default there only logs a startup warning and boots
# anyway, since Google-source fetches degrade to per-doc ingest warnings rather
# than breaking the catalog — set a strong, unique value there too to enable them.
DOCS_ENV=local
# doc-backfill CLI only — the service itself never reads these. The CLI is an
# HTTP client of this service, so it needs a base URL and a scoped key rather
# than DATABASE_URL. Scopes: docs:read docs:read:all docs:write (or admin);
# --dry-run needs only the two read scopes. The CLI checks its own scopes via
# GET /api-keys/self and refuses to run under-scoped, because a key without
# docs:read:all sees an empty catalog rather than a 403.
# Keep the key out of argv; the CLI reads it from the environment only.
DOCS_BASE_URL=http://localhost:8001
DOCS_API_KEY=dev-api-key-change-me
