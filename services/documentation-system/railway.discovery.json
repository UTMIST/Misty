  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "services/documentation-system/Dockerfile" },
  "deploy": {
    "startCommand": "python -m src.discovery",
    "cronSchedule": "*/15 * * * *",
