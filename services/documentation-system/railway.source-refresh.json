{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "services/documentation-system/Dockerfile" },
  "deploy": {
    "startCommand": "python -c \"print('Source refresh disabled outside staging')\"",
    "cronSchedule": null,
    "preDeployCommand": null,
    "healthcheckPath": null,
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  },
  "environments": {
    "staging": {
      "deploy": {
        "startCommand": "python -m src.source_refresh --require-monitor --meeting-records",
        "cronSchedule": "0 * * * *"
      }
    },
    "pr": {
      "deploy": {
        "startCommand": "python -c \"print('Source refresh disabled in PR previews')\"",
        "cronSchedule": null
      }
    }
  }
}
