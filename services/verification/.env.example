DATABASE_URL=postgresql+psycopg://verification:dev_password@localhost:5434/verification
API_KEY=dev-api-key-change-me
# Optional scoped vf_ consumers; JSON entries hold only argon2 hashes.
CONSUMER_KEYS=[]
CODE_HMAC_SECRET=dev-hmac-secret-change-me
VF_ENV=local

# Email delivery: fake (tests/dev, drops mail) | resend | gmail
EMAIL_BACKEND=fake
EMAIL_FROM=UTMIST <noreply@utmist.ca>

# Resend (https://resend.com) — HTTPS API, works on any Railway plan
# RESEND_API_KEY=re_your_api_key

# Gmail API (service account + domain-wide delegation) — alternative to Resend
# GMAIL_SENDER=noreply@your-workspace-domain
# GMAIL_CREDENTIALS_JSON=<base64 service-account JSON>
