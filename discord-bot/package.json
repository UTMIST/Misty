{
  "name": "utmist-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env src/index.js",
    "dev": "ENABLE_DISCORD=true ENABLE_WEB=true node --env-file=.env src/index.js",
    "dev:web": "node scripts/dev-web.js",
    "dev:web:plain": "ENABLE_DISCORD=false ENABLE_WEB=true node --env-file=.env src/index.js",
    "dev:discord": "ENABLE_DISCORD=true ENABLE_WEB=false node --env-file=.env src/index.js",
    "register": "node --env-file=.env src/registerCommands.js",
    "register:staging": "railway run --service discord-bot --environment staging -- node src/registerCommands.js",
    "register:production": "railway run --service discord-bot --environment production -- node src/registerCommands.js",
    "register:all": "npm run register:staging && npm run register:production",
    "test": "node --test"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@fastify/static": "^10.1.2",
    "discord.js": "^14.26.4",
    "fastify": "^5.9.0",
    "libsodium-wrappers": "0.7.13",
    "ws": "^8.21.1"
  },
  "overrides": {
    "undici": "^6.28.0"
  }
}
