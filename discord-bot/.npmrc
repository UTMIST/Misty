# Turn the engines field into a hard failure instead of a warning.
#
# Without this, `npm ci` on an unsupported Node prints EBADENGINE warnings that
# scroll past, and the failure surfaces later as something unrelated-looking:
#   SyntaxError: 'node:test' does not provide an export named 'mock'   (Node 18)
#   TypeError: diagnostics.tracingChannel is not a function            (Node 18)
# Neither message mentions the Node version. Failing at install is kinder.
engine-strict=true
