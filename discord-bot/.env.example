# Discord application credentials (Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional persistent Railway preview slot. Leave blank locally and on
# staging/production. See ../docs/pr-previews.md for setup and PR selection.
# This must be the literal environment UUID, not a Railway reference variable.
MISTY_PREVIEW_ENVIRONMENT_ID=
DISCORD_TOKEN_DEV=
DISCORD_CLIENT_ID_DEV=
DISCORD_GUILD_ID_DEV=

# Preview selector only: optional Railway project override (defaults to Misty).
# Export in your shell; npm run preview does not load this .env file.
# --project takes precedence over this variable.
MISTY_PREVIEW_PROJECT_ID=

# Optional: Discord username or user ID shown in the /bug response for
# infrastructure support. If unset, /bug only returns the GitHub issue link.
INFRASTRUCTURE_DISCORD_USERNAME=infrastructure-team

# Dedicated TESTING guild ID. Beta commands (those marked `export const beta =
# true`) register EXCLUSIVELY to this guild — they never reach production. Stable
# commands always register globally regardless. Required only if you have beta
# commands; leave blank otherwise.
DISCORD_GUILD_ID=

# team-tracking directory API. Issue a key with the full scope set the bot needs
# (this list is the source of truth in scripts/provision-directory-key.sh — a
# shorter list boots fine but 403s on /team, /seed and /my-teams):
#   uv --project services/team-tracking run team-tracking-keys issue \
#     --name discord-bot \
#     --scopes people:read people:write people:elevate \
#              identifiers:read identifiers:write \
#              teams:read teams:write memberships:read memberships:write \
#              role_kinds:read
# Always pass --project: a bare `team-tracking-keys` can resolve
# documentation-system's CLI and mint an unusable doc_-prefixed key.
DIRECTORY_BASE_URL=http://localhost:8000
DIRECTORY_API_KEY=

DOC_BASE_URL=http://localhost:8001
# The bootstrap key works for /doc add, but /doc list and /doc search act as the
# caller and need a scoped key with literal act-as-user (admin does not imply it):
#   uv --project services/documentation-system run doc-keys issue --name discord-bot \
#     --scopes docs:read docs:write act-as-user act-as-channel meetings:read meetings:write
# meetings:read/meetings:write enable saved Google Doc link delivery and recovery.
DOC_API_KEY=dev-api-key-change-me

LLM_BASE_URL=http://localhost:8002
LLM_API_KEY=dev-api-key-change-me

# Per-Discord-user helper request allowance (positive integers; optional).
# In-memory fixed windows; admitted attempts, including failures, consume a slot.
# These are startup defaults; admins can change them live with /helper-limits.
# Restarting the bot resets usage. See docs/helper-limits.md for accounting.
HELPER_USER_MAX_REQUESTS=10
HELPER_USER_WINDOW_SECONDS=3600

# Enable authorized document and command tools for mentions and DMs. Only the
# literal "true" turns it on; anything else (or unset) keeps the helper text-only.
# Command tools authenticate the requester; writes require private confirmation.
# The loop calls the doc service's POST /search (person scope in DMs, channel
# scope in configured channels), so the bot's DOC_API_KEY must carry act-as-user
# and act-as-channel. Leave OFF until retrieval and channel configuration are
# live in the target environment (#210/#239/#278).
HELPER_TOOLS_ENABLED=false

# verification service (email one-time codes for /link)
VERIFICATION_BASE_URL=http://localhost:8003
VERIFICATION_API_KEY=dev-api-key-change-me

# meeting service (/record voice recording -> minutes PDF).
# Leave MEETING_BASE_URL blank to disable /record — the bot boots fine and the
# command reports "not configured" rather than failing.
# Mint MEETING_API_KEY with:
#   uv --project services/meeting run meeting-keys --name discord-bot --scopes meetings
MEETING_BASE_URL=http://localhost:8004
MEETING_API_KEY=dev-api-key-change-me
# Optional: the bot derives ws:// or wss:// from MEETING_BASE_URL. Set this only
# to override that (e.g. a separate WS ingress).
MEETING_WS_URL=

# Which surfaces to start (src/index.js). The npm scripts set these for you —
# `npm start`/`dev:discord` (Discord only), `dev:web:plain` (web only),
# `dev` (both) — so you normally leave these blank. Railway sets them explicitly.
#   ENABLE_DISCORD: anything except the literal "false" enables it (default: on)
#   ENABLE_WEB:     must be the literal "true" to enable it   (default: off)
ENABLE_DISCORD=
ENABLE_WEB=
# Discord gateway readiness listener. Defaults to 3002.
PORT=3002
# Port for the web playground / web surface. Defaults to 3001.
WEB_PORT=3001
