    {"name":"restart","extra":["record.pdf_requested","capture.started","capture.stop_requested","stop.request"],"spans":[
      {"id":16,"op":"meeting.finalize","parent":2,"end":null}],
     "expected":{"workflow":"unconfirmed","ends":0,"unfinished":1}}
  ]
