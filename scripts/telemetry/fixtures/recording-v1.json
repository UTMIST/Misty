      {"id":16,"op":"meeting.finalize","parent":2,"end":"success"},
      {"id":17,"op":"meeting.handoff","parent":16,"end":"failed"},
      {"id":18,"op":"meeting.handoff","parent":16,"end":"success"}],
     "expected":{"workflow":"complete","ends":3,"unfinished":0}},
    {"name":"cancelled","extra":["record.pdf_requested","capture.started","capture.stop_requested","stop.request"],"spans":[
      {"id":16,"op":"meeting.finalize","parent":2,"end":"cancelled"}],
